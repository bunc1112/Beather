<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/bg_solid_r24"
        android:contentDescription="@null" />
    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:padding="14dp">
        <LinearLayout android:id="@+id/header" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/loc_name" android:layout_height="wrap_content" android:text="@string/app_name" android:textColor="#FFFFFF" android:textSize="17sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" android:layout_width="0dp" android:layout_weight="1" android:maxLines="1" android:ellipsize="end"/>
            <LinearLayout android:id="@+id/alarm_group" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
                <ImageView android:id="@+id/alarm_icon" android:layout_width="16dp" android:layout_height="16dp" android:scaleType="fitCenter" android:contentDescription="@null" android:src="@drawable/ic_alarm" android:layout_marginEnd="6dp"/>
                <TextView android:id="@+id/alarm_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="15sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" />
            </LinearLayout>
            <TextView android:id="@+id/updated" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="11sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" android:layout_marginStart="8dp" android:textColor="#B3FFFFFF"/>
            <ImageView android:id="@+id/refresh" android:layout_width="28dp" android:layout_height="28dp" android:scaleType="fitCenter" android:contentDescription="@null" android:padding="5dp" android:src="@drawable/ic_refresh"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/cal_g_row" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
            <ImageView android:id="@+id/cal_g_icon" android:layout_width="15dp" android:layout_height="15dp" android:scaleType="fitCenter" android:contentDescription="@null" android:src="@drawable/ic_event" android:layout_marginEnd="7dp"/>
            <TextView android:id="@+id/cal_g_text" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="15sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" android:layout_width="0dp" android:layout_weight="1" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/cal_o_row" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
            <ImageView android:id="@+id/cal_o_icon" android:layout_width="15dp" android:layout_height="15dp" android:scaleType="fitCenter" android:contentDescription="@null" android:src="@drawable/ic_event" android:layout_marginEnd="7dp"/>
            <TextView android:id="@+id/cal_o_text" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="15sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" android:layout_width="0dp" android:layout_weight="1" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/main_row" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:id="@+id/clock_group" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextClock android:id="@+id/clock_0" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format12Hour="h:mm" android:format24Hour="H:mm" android:fontFamily="sans-serif-thin" android:includeFontPadding="false"
            android:textColor="#FFFFFF" android:textSize="60sp" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" android:visibility="visible"/>
                <TextClock android:id="@+id/clock_1" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format12Hour="h:mm" android:format24Hour="H:mm" android:fontFamily="sans-serif-light" android:includeFontPadding="false"
            android:textColor="#FFFFFF" android:textSize="60sp" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" android:visibility="gone"/>
                <TextClock android:id="@+id/clock_2" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format12Hour="h:mm" android:format24Hour="H:mm" android:fontFamily="sans-serif" android:includeFontPadding="false"
            android:textColor="#FFFFFF" android:textSize="60sp" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" android:visibility="gone"/>
                <TextClock android:id="@+id/clock_3" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format12Hour="h:mm" android:format24Hour="H:mm" android:fontFamily="sans-serif-medium" android:includeFontPadding="false"
            android:textColor="#FFFFFF" android:textSize="60sp" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" android:visibility="gone"/>
                <TextClock android:id="@+id/date_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:format12Hour="@string/date_format" android:format24Hour="@string/date_format"
                    android:includeFontPadding="false" android:textColor="#FFFFFF" android:textSize="15sp" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/cur_group" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:gravity="end" android:orientation="vertical">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/cur_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°" android:textColor="#FFFFFF" android:textSize="48sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" android:fontFamily="sans-serif-light"/>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="4dp" android:gravity="end" android:orientation="vertical">
                        <TextView android:id="@+id/cur_max" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="18sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" />
                        <TextView android:id="@+id/cur_min" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="18sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" android:layout_marginTop="2dp"/>
                    </LinearLayout>
                    <ImageView android:id="@+id/cur_icon" android:layout_width="64dp" android:layout_height="64dp" android:scaleType="fitCenter" android:contentDescription="@null" android:layout_marginStart="8dp" android:src="@drawable/ic_w_partly_day"/>
                </LinearLayout>
                <TextView android:id="@+id/cur_desc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/loading" android:textColor="#FFFFFF" android:textSize="17sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end"/>
            </LinearLayout>
        </LinearLayout>

        <TextView android:id="@+id/cur_details" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" android:layout_marginTop="6dp" android:maxLines="2" android:ellipsize="end" android:textColor="#CCFFFFFF"/>

        <LinearLayout android:id="@+id/hourly_row" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:background="@drawable/widget_row_bg" android:orientation="horizontal"
            android:paddingTop="5dp" android:paddingBottom="5dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:gravity="center_horizontal" android:orientation="vertical">
                <TextView android:id="@+id/h0_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="12sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" />
                <ImageView android:id="@+id/h0_icon" android:layout_width="30dp" android:layout_height="30dp" android:scaleType="fitCenter" android:contentDescription="@null" android:layout_marginTop="2dp" android:layout_marginBottom="2dp"/>
                <TextView android:id="@+id/h0_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="13sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" />
                <TextView android:id="@+id/h0_pop" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="11sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" android:textColor="#90CAF9"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:gravity="center_horizontal" android:orientation="vertical">
                <TextView android:id="@+id/h1_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="12sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" />
                <ImageView android:id="@+id/h1_icon" android:layout_width="30dp" android:layout_height="30dp" android:scaleType="fitCenter" android:contentDescription="@null" android:layout_marginTop="2dp" android:layout_marginBottom="2dp"/>
                <TextView android:id="@+id/h1_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="13sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" />
                <TextView android:id="@+id/h1_pop" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="11sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" android:textColor="#90CAF9"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:gravity="center_horizontal" android:orientation="vertical">
                <TextView android:id="@+id/h2_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="12sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" />
                <ImageView android:id="@+id/h2_icon" android:layout_width="30dp" android:layout_height="30dp" android:scaleType="fitCenter" android:contentDescription="@null" android:layout_marginTop="2dp" android:layout_marginBottom="2dp"/>
                <TextView android:id="@+id/h2_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="13sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" />
                <TextView android:id="@+id/h2_pop" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="11sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" android:textColor="#90CAF9"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:gravity="center_horizontal" android:orientation="vertical">
                <TextView android:id="@+id/h3_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="12sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" />
                <ImageView android:id="@+id/h3_icon" android:layout_width="30dp" android:layout_height="30dp" android:scaleType="fitCenter" android:contentDescription="@null" android:layout_marginTop="2dp" android:layout_marginBottom="2dp"/>
                <TextView android:id="@+id/h3_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="13sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" />
                <TextView android:id="@+id/h3_pop" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="11sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" android:textColor="#90CAF9"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:gravity="center_horizontal" android:orientation="vertical">
                <TextView android:id="@+id/h4_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="12sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" />
                <ImageView android:id="@+id/h4_icon" android:layout_width="30dp" android:layout_height="30dp" android:scaleType="fitCenter" android:contentDescription="@null" android:layout_marginTop="2dp" android:layout_marginBottom="2dp"/>
                <TextView android:id="@+id/h4_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="13sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" />
                <TextView android:id="@+id/h4_pop" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="11sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" android:textColor="#90CAF9"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:gravity="center_horizontal" android:orientation="vertical">
                <TextView android:id="@+id/h5_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="12sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" />
                <ImageView android:id="@+id/h5_icon" android:layout_width="30dp" android:layout_height="30dp" android:scaleType="fitCenter" android:contentDescription="@null" android:layout_marginTop="2dp" android:layout_marginBottom="2dp"/>
                <TextView android:id="@+id/h5_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="13sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" />
                <TextView android:id="@+id/h5_pop" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="11sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" android:textColor="#90CAF9"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/days_row" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:orientation="horizontal">
            <LinearLayout android:id="@+id/d0_cell" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:gravity="center_horizontal" android:orientation="vertical" android:paddingTop="2dp" android:paddingBottom="2dp">
                <TextView android:id="@+id/d0_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="14sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" />
                <ImageView android:id="@+id/d0_icon" android:layout_width="40dp" android:layout_height="40dp" android:scaleType="fitCenter" android:contentDescription="@null" android:layout_marginTop="3dp" android:layout_marginBottom="3dp"/>
                <TextView android:id="@+id/d0_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="15sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" />
            </LinearLayout>
            <LinearLayout android:id="@+id/d1_cell" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:gravity="center_horizontal" android:orientation="vertical" android:paddingTop="2dp" android:paddingBottom="2dp">
                <TextView android:id="@+id/d1_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="14sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" />
                <ImageView android:id="@+id/d1_icon" android:layout_width="40dp" android:layout_height="40dp" android:scaleType="fitCenter" android:contentDescription="@null" android:layout_marginTop="3dp" android:layout_marginBottom="3dp"/>
                <TextView android:id="@+id/d1_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="15sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" />
            </LinearLayout>
            <LinearLayout android:id="@+id/d2_cell" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:gravity="center_horizontal" android:orientation="vertical" android:paddingTop="2dp" android:paddingBottom="2dp">
                <TextView android:id="@+id/d2_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="14sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" />
                <ImageView android:id="@+id/d2_icon" android:layout_width="40dp" android:layout_height="40dp" android:scaleType="fitCenter" android:contentDescription="@null" android:layout_marginTop="3dp" android:layout_marginBottom="3dp"/>
                <TextView android:id="@+id/d2_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="15sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" />
            </LinearLayout>
            <LinearLayout android:id="@+id/d3_cell" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:gravity="center_horizontal" android:orientation="vertical" android:paddingTop="2dp" android:paddingBottom="2dp">
                <TextView android:id="@+id/d3_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="14sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" />
                <ImageView android:id="@+id/d3_icon" android:layout_width="40dp" android:layout_height="40dp" android:scaleType="fitCenter" android:contentDescription="@null" android:layout_marginTop="3dp" android:layout_marginBottom="3dp"/>
                <TextView android:id="@+id/d3_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="15sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" />
            </LinearLayout>
            <LinearLayout android:id="@+id/d4_cell" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:gravity="center_horizontal" android:orientation="vertical" android:paddingTop="2dp" android:paddingBottom="2dp">
                <TextView android:id="@+id/d4_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="14sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" />
                <ImageView android:id="@+id/d4_icon" android:layout_width="40dp" android:layout_height="40dp" android:scaleType="fitCenter" android:contentDescription="@null" android:layout_marginTop="3dp" android:layout_marginBottom="3dp"/>
                <TextView android:id="@+id/d4_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="15sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" />
            </LinearLayout>
            <LinearLayout android:id="@+id/d5_cell" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:gravity="center_horizontal" android:orientation="vertical" android:paddingTop="2dp" android:paddingBottom="2dp">
                <TextView android:id="@+id/d5_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="14sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" />
                <ImageView android:id="@+id/d5_icon" android:layout_width="40dp" android:layout_height="40dp" android:scaleType="fitCenter" android:contentDescription="@null" android:layout_marginTop="3dp" android:layout_marginBottom="3dp"/>
                <TextView android:id="@+id/d5_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="15sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" />
            </LinearLayout>
            <LinearLayout android:id="@+id/d6_cell" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:gravity="center_horizontal" android:orientation="vertical" android:paddingTop="2dp" android:paddingBottom="2dp">
                <TextView android:id="@+id/d6_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="14sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" />
                <ImageView android:id="@+id/d6_icon" android:layout_width="40dp" android:layout_height="40dp" android:scaleType="fitCenter" android:contentDescription="@null" android:layout_marginTop="3dp" android:layout_marginBottom="3dp"/>
                <TextView android:id="@+id/d6_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="15sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:id="@+id/source" android:layout_height="wrap_content" android:text="" android:textSize="9sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" android:layout_width="match_parent" android:layout_marginTop="6dp" android:gravity="end" android:maxLines="1" android:ellipsize="end" android:textColor="#80FFFFFF"/>
    </LinearLayout>
</FrameLayout>
