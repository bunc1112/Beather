<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_day"
    android:orientation="vertical"
    android:padding="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/loc_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#B3FFFFFF"
            android:textSize="11sp" />
        <ImageView
            android:id="@+id/refresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="5dp"
            android:src="@drawable/ic_refresh"
            android:contentDescription="@string/refresh" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/cur_icon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/ic_w_partly_day"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/cur_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="sans-serif-light"
            android:text="--°"
            android:textColor="#FFFFFF"
            android:textSize="46sp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/cur_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/loading"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/cur_hilo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#E6FFFFFF"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/cur_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:text=""
                android:textColor="#CCFFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_row_bg"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView android:id="@+id/h0_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#CCFFFFFF" android:textSize="11sp" />
            <ImageView android:id="@+id/h0_icon" android:layout_width="24dp" android:layout_height="24dp"
                android:layout_marginTop="2dp" android:contentDescription="@null" />
            <TextView android:id="@+id/h0_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#FFFFFF" android:textSize="12sp" />
            <TextView android:id="@+id/h0_pop" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#90CAF9" android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView android:id="@+id/h1_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#CCFFFFFF" android:textSize="11sp" />
            <ImageView android:id="@+id/h1_icon" android:layout_width="24dp" android:layout_height="24dp"
                android:layout_marginTop="2dp" android:contentDescription="@null" />
            <TextView android:id="@+id/h1_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#FFFFFF" android:textSize="12sp" />
            <TextView android:id="@+id/h1_pop" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#90CAF9" android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView android:id="@+id/h2_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#CCFFFFFF" android:textSize="11sp" />
            <ImageView android:id="@+id/h2_icon" android:layout_width="24dp" android:layout_height="24dp"
                android:layout_marginTop="2dp" android:contentDescription="@null" />
            <TextView android:id="@+id/h2_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#FFFFFF" android:textSize="12sp" />
            <TextView android:id="@+id/h2_pop" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#90CAF9" android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView android:id="@+id/h3_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#CCFFFFFF" android:textSize="11sp" />
            <ImageView android:id="@+id/h3_icon" android:layout_width="24dp" android:layout_height="24dp"
                android:layout_marginTop="2dp" android:contentDescription="@null" />
            <TextView android:id="@+id/h3_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#FFFFFF" android:textSize="12sp" />
            <TextView android:id="@+id/h3_pop" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#90CAF9" android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView android:id="@+id/h4_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#CCFFFFFF" android:textSize="11sp" />
            <ImageView android:id="@+id/h4_icon" android:layout_width="24dp" android:layout_height="24dp"
                android:layout_marginTop="2dp" android:contentDescription="@null" />
            <TextView android:id="@+id/h4_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#FFFFFF" android:textSize="12sp" />
            <TextView android:id="@+id/h4_pop" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#90CAF9" android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView android:id="@+id/h5_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#CCFFFFFF" android:textSize="11sp" />
            <ImageView android:id="@+id/h5_icon" android:layout_width="24dp" android:layout_height="24dp"
                android:layout_marginTop="2dp" android:contentDescription="@null" />
            <TextView android:id="@+id/h5_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#FFFFFF" android:textSize="12sp" />
            <TextView android:id="@+id/h5_pop" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#90CAF9" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView android:id="@+id/d0_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#E6FFFFFF" android:textSize="11sp" />
            <ImageView android:id="@+id/d0_icon" android:layout_width="26dp" android:layout_height="26dp"
                android:layout_marginTop="2dp" android:contentDescription="@null" />
            <TextView android:id="@+id/d0_max" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/d0_min" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#B3FFFFFF" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView android:id="@+id/d1_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#E6FFFFFF" android:textSize="11sp" />
            <ImageView android:id="@+id/d1_icon" android:layout_width="26dp" android:layout_height="26dp"
                android:layout_marginTop="2dp" android:contentDescription="@null" />
            <TextView android:id="@+id/d1_max" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/d1_min" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#B3FFFFFF" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView android:id="@+id/d2_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#E6FFFFFF" android:textSize="11sp" />
            <ImageView android:id="@+id/d2_icon" android:layout_width="26dp" android:layout_height="26dp"
                android:layout_marginTop="2dp" android:contentDescription="@null" />
            <TextView android:id="@+id/d2_max" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/d2_min" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#B3FFFFFF" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView android:id="@+id/d3_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#E6FFFFFF" android:textSize="11sp" />
            <ImageView android:id="@+id/d3_icon" android:layout_width="26dp" android:layout_height="26dp"
                android:layout_marginTop="2dp" android:contentDescription="@null" />
            <TextView android:id="@+id/d3_max" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/d3_min" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#B3FFFFFF" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView android:id="@+id/d4_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#E6FFFFFF" android:textSize="11sp" />
            <ImageView android:id="@+id/d4_icon" android:layout_width="26dp" android:layout_height="26dp"
                android:layout_marginTop="2dp" android:contentDescription="@null" />
            <TextView android:id="@+id/d4_max" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/d4_min" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#B3FFFFFF" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/source"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="end"
        android:maxLines="1"
        android:text=""
        android:textColor="#80FFFFFF"
        android:textSize="9sp" />
</LinearLayout>
