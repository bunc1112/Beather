<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/bg_solid_r24"
        android:contentDescription="@null" />
    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="top"
        android:orientation="vertical"
        android:padding="12dp">
        <TextView android:id="@+id/loc_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_name" android:textColor="#FFFFFF" android:textSize="14sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" android:maxLines="1" android:ellipsize="end" android:textStyle="bold"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:gravity="center_vertical" android:orientation="horizontal">
            <FrameLayout android:id="@+id/cur_icon" android:layout_width="wrap_content" android:layout_height="wrap_content" ><ImageView android:id="@+id/cur_icon_v0" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:scaleType="fitCenter" android:contentDescription="@null" android:visibility="gone"/><ImageView android:id="@+id/cur_icon_v1" android:layout_width="52dp" android:layout_height="52dp" android:layout_gravity="center" android:scaleType="fitCenter" android:contentDescription="@null" android:visibility="visible" android:src="@drawable/ic_w_partly_day"/><ImageView android:id="@+id/cur_icon_v2" android:layout_width="64dp" android:layout_height="64dp" android:layout_gravity="center" android:scaleType="fitCenter" android:contentDescription="@null" android:visibility="gone"/><ImageView android:id="@+id/cur_icon_v3" android:layout_width="80dp" android:layout_height="80dp" android:layout_gravity="center" android:scaleType="fitCenter" android:contentDescription="@null" android:visibility="gone"/><ImageView android:id="@+id/cur_icon_v4" android:layout_width="100dp" android:layout_height="100dp" android:layout_gravity="center" android:scaleType="fitCenter" android:contentDescription="@null" android:visibility="gone"/><ImageView android:id="@+id/cur_icon_v5" android:layout_width="124dp" android:layout_height="124dp" android:layout_gravity="center" android:scaleType="fitCenter" android:contentDescription="@null" android:visibility="gone"/></FrameLayout>
            <TextView android:id="@+id/cur_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°" android:textColor="#FFFFFF" android:textSize="36sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" android:layout_marginStart="4dp" android:fontFamily="sans-serif-light"/>
        </LinearLayout>
        <TextView android:id="@+id/cur_desc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/loading" android:textColor="#FFFFFF" android:textSize="13sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/cur_hilo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="13sp" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="3" />
    </LinearLayout>
</FrameLayout>
